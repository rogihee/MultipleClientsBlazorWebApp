@inject IJSRuntime JS

<div class="game-tools">
    <strong>GameOnlyLib</strong>: only logged-in players can download this library.
    <code>@(moduleUrl ?? "loading module...")</code>
</div>

@code {
    /// <summary>Unversioned on purpose: the import map of a game page maps it to the fingerprinted file.</summary>
    public const string ModuleUrl = "./_content/GameOnlyLib/game-tools.js";

    private string? moduleUrl;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", ModuleUrl);
        moduleUrl = await module.InvokeAsync<string>("moduleUrl");
        StateHasChanged();
    }
}
